# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Exact origins only. https://localhost is the Capacitor Android WebView origin (androidScheme https).
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,https://localhost

# Valryde application PostgreSQL/PostGIS (add local credentials only in the ignored .env)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/valryde
DATABASE_SSL=false
DATABASE_SCHEMA=dbo

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=valryde-api
JWT_AUDIENCE=valryde-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_CHALLENGE_TTL_MINUTES=30
AUTH_RESEND_COOLDOWN_SECONDS=60
GOOGLE_CLIENT_IDS=

# Interactive local, preview, and production environments use an authenticated SMTP provider.
# Replace every placeholder below in the ignored .env or deployment secret store.
# EMAIL_DELIVERY_MODE=disabled is reserved for controlled seeding/non-interactive tooling.
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM="VALRYDE <replace-with-authorized-sender@example.com>"
APP_VERIFICATION_URL=http://localhost:4200/auth/verify-email
APP_PASSWORD_RESET_URL=http://localhost:4200/auth/reset-password
APP_EMAIL_CHANGE_URL=http://localhost:4200/account/confirm-email-change
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-runtime-secret

# Optional automated/integration-test override (Mailpit; never use as an interactive default):
# EMAIL_FROM="VALRYDE <no-reply@valryde.local>"
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# Remove SMTP_USER and SMTP_PASSWORD for Mailpit unless that test server requires authentication.

# Server-side Traccar integration (optional until tracking is configured).
# Use a dedicated service account; remote hosts require HTTPS. Never send these to clients.
# TRACCAR_BASE_URL=http://127.0.0.1:8082
# TRACCAR_EMAIL=
# TRACCAR_PASSWORD=
# TRACCAR_TIMEOUT_MS=5000
# TRACCAR_MAX_RETRIES=2
# TRACCAR_RETRY_BASE_MS=250
# TRACCAR_RETRY_MAX_MS=5000

# Persistent Tracking Bridge (npm run bridge:start). Operational settings only; see
# docs/TRACKING_BRIDGE_OPERATIONS.md. Health listens on 127.0.0.1 only; 0 disables it.
# BRIDGE_HEALTH_PORT=0
# BRIDGE_CONNECT_TIMEOUT_MS=5000
# BRIDGE_SILENCE_TIMEOUT_MS=120000
# BRIDGE_RECONNECT_BASE_MS=1000
# BRIDGE_RECONNECT_MAX_MS=30000
# BRIDGE_STABLE_RESET_MS=60000
# BRIDGE_SHUTDOWN_TIMEOUT_MS=10000
# BRIDGE_MAX_FRAME_BYTES=1048576
# BRIDGE_MAX_FRAME_ITEMS=1000
# BRIDGE_MAX_QUEUED_FRAMES=1000
# BRIDGE_FUTURE_TOLERANCE_MS=5000

# First Admin bootstrap (set these only as temporary shell environment variables;
# never save the Admin password in .env or pass it as a command-line argument)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_DISPLAY_NAME=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_CONFIRM=CREATE_FIRST_ADMIN

# Development fixture boundary (set only as temporary shell variables; see
# docs/development/DEVELOPMENT_FIXTURES.md). Never store the fixture password here.
# DEV_FIXTURE_TARGET_DATABASE=valryde

# G6 place search. Keep disabled until the owner approves a provider and its usage terms.
GEOCODER_PROVIDER=disabled
# PHOTON_BASE_URL=https://photon.example.org/
GEOCODER_COUNTRY_BIAS=ph
